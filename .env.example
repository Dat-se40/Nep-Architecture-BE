NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# Runtime: use a PostgreSQL role restricted to the nep schema.
# Copy the exact connection string from Supabase's Connect dialog.
DATABASE_URL="postgresql://nep_api.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Prisma migrations: privileged direct connection or session pooler (5432).
# Do not use the transaction pooler (6543) for migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Supabase
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET="<client-secret>"
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for calling the private admin-ids Edge Function.
SUPABASE_SECRET_KEY=
# Optional, for future local JWT verification; getUser currently verifies remotely.
SUPABASE_JWKS_URL=

# Cloudflare R2: server-only S3 credentials for the existing public media bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=nep-architecture
# Optional folder prefix inside the bucket. New images use nep-media/projects/...
R2_MEDIA_PREFIX=nep-media
# Bucket Settings -> Public Development URL, or the production custom domain.
R2_PUBLIC_BASE_URL=
# Optional: jurisdiction-specific S3 endpoint, otherwise derived from account ID.
R2_ENDPOINT=
